{
  "name": "axe-guide",
  "private": true,
  "version": "1.0.0",
  "description": "A bilingual guide to axe accessibility testing, with no scanner running on the page.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "i18n:check": "node check-i18n-order.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
